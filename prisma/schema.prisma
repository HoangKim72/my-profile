// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============= ROLES & PERMISSIONS =============

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  userRoles UserRole[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============= USER PROFILE =============

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile?
  userRoles          UserRole[]
  projects           Project[]
  projectPermissions ProjectPermission[]
  projectFiles       ProjectFile[]
  messages           ContactMessage[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  fullName    String?
  headline    String?
  bio         String?
  avatarUrl   String?
  email       String?
  phone       String?
  githubUrl   String?
  linkedinUrl String?
  facebookUrl String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============= PROJECTS =============

model Project {
  id               String  @id @default(cuid())
  slug             String  @unique
  title            String
  shortDescription String
  content          String  @db.Text
  subjectName      String // Tên môn học (e.g., "Web Development")
  semester         String // Kỳ học (e.g., "Fall 2024")
  techStack        String // JSON string hoặc comma-separated
  githubUrl        String?
  demoUrl          String?
  thumbnailUrl     String?
  coverImageUrl    String?
  downloadCount    Int     @default(0)

  status     ProjectStatus @default(DRAFT) // DRAFT, PUBLISHED, ARCHIVED
  visibility Visibility    @default(PRIVATE) // PUBLIC, PRIVATE, SHARED

  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  files       ProjectFile[]
  permissions ProjectPermission[]

  @@index([authorId])
  @@index([status])
  @@index([visibility])
  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
  SHARED
}

// ============= PROJECT FILES & IMAGES =============

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  fileName   String
  filePath   String // Supabase storage path
  fileType   String // e.g., "pdf", "zip", "doc"
  mimeType   String
  sizeBytes  Int
  entries    Json? // ArchiveManifest: danh sách file bên trong ZIP
  uploadedBy String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_files")
}

// ============= PROJECT PERMISSIONS =============

model ProjectPermission {
  id             String         @id @default(cuid())
  projectId      String
  userId         String
  permissionType PermissionType @default(VIEW) // VIEW, EDIT
  createdAt      DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_permissions")
}

enum PermissionType {
  VIEW
  EDIT
}

// ============= CONTACT MESSAGES =============

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  userId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([isRead])
  @@map("contact_messages")
}

// ============= TOOL SETTINGS =============

// Key/value settings for the web tools, e.g. key "mic-filter" holds the
// MicFilterConfig JSON (wireless rooms, shift windows, alarm rules)
model ToolSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("tool_settings")
}

// ============= AIR-CONDITIONER SCHEDULER =============
// The web app only plans; a LAN agent (agent/ac-agent) polls
// /api/ac-agent/plan, drives the Daikin iTM controllers and reports back.
// ac_events, ac_jobs and ac_units are published to Supabase Realtime.

// One indoor unit on an iTM controller. ip + floorName + unitIndex locate it
// on the iTM layout screen; name is what iTM shows and is re-checked before
// every command.
model AcUnit {
  id        String    @id @default(cuid())
  name      String
  itmIp     String
  floorName String
  unitIndex Int
  // Schedule room codes this unit cools, e.g. ["E1-12.02"]
  roomCodes String[]
  enabled   Boolean   @default(true)
  // Last state reported by the agent (null = unknown)
  isRunning Boolean?
  stateAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  jobs AcJob[]

  @@unique([itmIp, floorName, unitIndex])
  @@map("ac_units")
}

// An activated schedule for one day. Re-importing the same day supersedes
// the previous one and cancels its pending jobs.
model AcSchedule {
  id             String           @id @default(cuid())
  dateKey        String
  status         AcScheduleStatus @default(ACTIVE)
  fileName       String
  // AcPlan counters shown in the history (rows, skipped, units...)
  summary        Json
  createdById    String
  createdByEmail String
  createdAt      DateTime         @default(now())
  endedAt        DateTime?

  jobs AcJob[]

  @@index([dateKey, status])
  @@map("ac_schedules")
}

enum AcScheduleStatus {
  ACTIVE
  SUPERSEDED
  CANCELLED
}

model AcJob {
  id          String      @id @default(cuid())
  scheduleId  String
  unitId      String
  action      AcAction
  runAt       DateTime
  // Class period this job belongs to (before the lead time is applied)
  windowStart DateTime
  windowEnd   DateTime
  roomCodes   String[]
  status      AcJobStatus @default(PENDING)
  attempts    Int         @default(0)
  result      String?
  updatedAt   DateTime    @updatedAt

  schedule AcSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  unit     AcUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([status, runAt])
  @@map("ac_jobs")
}

enum AcAction {
  ON
  OFF
}

enum AcJobStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
  FAILED
  CANCELLED
}

// Append-only log shown live on /tools/ac
model AcEvent {
  id        String       @id @default(cuid())
  level     AcEventLevel @default(INFO)
  message   String
  unitName  String?
  jobId     String?
  actor     String?
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@map("ac_events")
}

enum AcEventLevel {
  INFO
  WARN
  ERROR
}

// A machine allowed to call /api/ac-agent/*. Only the SHA-256 of its token
// is stored.
model AcAgent {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  lastSeenAt DateTime?
  lastIp     String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("ac_agents")
}
